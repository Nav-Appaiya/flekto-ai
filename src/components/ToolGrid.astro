---
import { TOOLS } from "../data/tools.js";
---
<ul class="grid">
  {TOOLS.map((t) => (
    <li><a class="card tool" href={t.href}>
      <span class="emoji" aria-hidden="true">{t.emoji}</span>
      <strong>{t.name}</strong>
      <span class="blurb">{t.blurb}</span>
    </a></li>
  ))}
</ul>
<style>
  .grid { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr)); }
  .tool { display: flex; flex-direction: column; gap: .4rem; height: 100%; color: inherit; text-decoration: none; }
  .tool:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: var(--shadow-hover); }
  .blurb { font-size: .92rem; color: var(--muted); line-height: 1.5; }
  .emoji { font-size: 2rem; line-height: 1; }
  strong { font-size: 1.05rem; font-weight: 700; }
</style>
