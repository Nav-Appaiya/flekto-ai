---
// Live idea feed: today's set (seeded by date) plus endless extra batches. `kind` is a key of SOURCES in lib/ideas.js.
const { kind } = Astro.props;
---
<div class="feed" data-kind={kind}>
  <p class="toolbar"><span class="status muted">Even kijken wat er trending is…</span></p>
  <h2>Ideeën van <span class="hl">vandaag</span></h2>
  <ol class="ideas today"></ol>
  <h2 class="more-head" hidden>Nog <span class="hl">meer</span></h2>
  <ol class="ideas more"></ol>
  <p><button type="button" class="btn next" disabled>Nog een paar ideeën</button></p>
  <p class="sources muted"></p>
</div>

<style>
  .ideas { list-style: none; padding: 0; margin: 1rem 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr)); }
  .ideas > :global(li) { display: flex; flex-direction: column; gap: .5rem; }
  .ideas :global(h3) { margin: 0; font-size: 1.15rem; line-height: 1.3; }
  .ideas :global(p) { margin: 0; }
  .ideas :global(dl) { display: grid; grid-template-columns: auto 1fr; gap: .15rem .75rem; margin: 0; font-size: .9rem; }
  .ideas :global(dt) { color: var(--muted); }
  .ideas :global(dd) { margin: 0; }
  .ideas :global(ol) { margin: 0; padding-left: 1.2rem; font-size: .92rem; }
  .ideas :global(.why) { margin-top: auto; padding-top: .5rem; border-top: 1px solid var(--line); font-size: .85rem; color: var(--muted); }
  .ideas :global(.why a) { color: inherit; }
  .ideas :global(.src) { display: inline-block; font-size: .7rem; font-weight: 700; padding: .05rem .4rem; border-radius: 4px; margin-right: .3rem; background: var(--line); color: var(--fg); }
</style>

<script>
  import { generateIdeas } from "../lib/ideas.js";

  type Signal = { title: string; url: string; source: string; topic?: string };
  type Idea = { title: string; pitch: string; facts: [string, string][]; steps: string[]; inspiration: Signal[] };

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text = "", className = "") =>
    Object.assign(document.createElement(tag), { textContent: text, className });

  function card(idea: Idea) {
    const li = el("li", "", "card");
    const facts = el("dl");
    for (const [k, v] of idea.facts) facts.append(el("dt", k), el("dd", v));
    li.append(el("h3", idea.title), el("p", idea.pitch), facts);
    if (idea.steps.length) {
      const steps = el("ol");
      steps.append(...idea.steps.map((s) => el("li", s)));
      li.append(steps);
    }
    if (idea.inspiration.length) {
      const why = el("p", "Gebaseerd op: ", "why");
      for (const s of idea.inspiration) {
        const link = Object.assign(el("a"), { href: s.url, target: "_blank", rel: "noopener" });
        link.append(el("span", s.source, "src"), s.title);
        why.append(link, " ");
      }
      li.append(why);
    }
    return li;
  }

  for (const root of document.querySelectorAll<HTMLElement>(".feed")) {
    const kind = root.dataset.kind!;
    const $ = <T extends Element>(sel: string) => root.querySelector<T>(sel)!;
    const status = $<HTMLElement>(".status");
    const next = $<HTMLButtonElement>(".next");

    fetch(`/api/ideas?kind=${kind}`).then(async (res) => {
      const data = await res.json();
      if (!res.ok) throw new Error(data.error);
      const today = new Date().toLocaleDateString("sv-SE", { timeZone: "Europe/Amsterdam" }); // YYYY-MM-DD
      $(".today").replaceChildren(...generateIdeas(kind, data.signals, `${kind}:${today}`).map(card));
      status.textContent = `Gebaseerd op ${data.signals.length} posts en projecten van deze week · bijgewerkt om ${new Date(data.updatedAt).toLocaleTimeString("nl-NL", { hour: "2-digit", minute: "2-digit" })}`;
      $(".sources").textContent = `Bronnen: ${data.sources.map((s: { name: string; ok: boolean }) => (s.ok ? s.name : `${s.name} (even niet bereikbaar)`)).join(", ")}.`;
      next.disabled = false;
      next.addEventListener("click", () => {
        $<HTMLElement>(".more-head").hidden = false;
        const batch = generateIdeas(kind, data.signals, crypto.randomUUID()).map(card);
        $(".more").prepend(...batch);
        batch[0]?.scrollIntoView({ behavior: "smooth", block: "nearest" });
      });
    }).catch((err) => { status.textContent = err.message || "Het lukte even niet om de trends op te halen. Probeer het zo nog eens."; });
  }
</script>
