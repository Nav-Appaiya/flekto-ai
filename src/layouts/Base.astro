---
const { title, description = "", noindex = false } = Astro.props;
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Flekto</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;600&display=swap" />
    <style is:global>
      /* Same look as the main flekto.nl site: HK Grotesk (Hanken Grotesk is its free successor), blue accent, navy text. */
      :root {
        --bg: #ffffff; --alt: #f9fbfd; --fg: #161c2d; --muted: #506690; --line: #e3ebf6; --card: #ffffff;
        --accent: #335eea; --accent-ink: #335eea; --accent-soft: rgba(51, 94, 234, .1); --ok: #42ba96;
        --bar: #869ab8; --bad: #df4759; --shadow: 0 8px 24px rgba(22, 28, 45, .1);
        color-scheme: light;
      }
      @media (prefers-color-scheme: dark) {
        :root { --bg: #161c2d; --alt: #1b2236; --fg: #e9eef7; --muted: #9aaccc; --line: #2b3550; --card: #1e2639;
                --accent: #335eea; --accent-ink: #8aa4ff; --accent-soft: rgba(51, 94, 234, .2); --ok: #42ba96;
                --bar: #55658a; --bad: #ff7a8a; --shadow: 0 8px 24px rgba(0, 0, 0, .35); color-scheme: dark; }
      }
      * { box-sizing: border-box; }
      [hidden] { display: none !important; }
      body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.6 "Hanken Grotesk", "HKGroteskPro", system-ui, -apple-system, sans-serif; }
      .wrap { max-width: 64rem; margin: 0 auto; padding: 0 16px; }
      header { border-bottom: 1px solid var(--line); background: var(--bg); }
      header .wrap { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 5rem; }
      header img { height: 34px; width: auto; display: block; }
      header nav { display: flex; gap: 1.8rem; }
      header nav a { color: var(--muted); text-decoration: none; font-weight: 600; }
      header nav a:hover, header nav a[aria-current] { color: var(--accent-ink); }
      main.wrap { padding-top: 3.5rem; padding-bottom: 5rem; }
      footer { background: var(--alt); border-top: 1px solid var(--line); color: var(--muted); font-size: .95rem; padding: 2.5rem 0; }
      footer .wrap { display: flex; flex-wrap: wrap; justify-content: space-between; gap: .5rem 2rem; }
      footer a { color: inherit; }
      h1, h2, h3 { font-weight: 400; color: var(--fg); }
      h1 { font-size: clamp(2rem, 5vw, 2.6rem); line-height: 1.2; margin: 0 0 1rem; }
      h2 { font-size: 1.6rem; line-height: 1.3; margin-top: 3rem; }
      .hl { color: var(--accent-ink); }
      a { color: var(--accent-ink); }
      .lead { font-size: 1.15rem; color: var(--muted); max-width: 42rem; }
      .muted { color: var(--muted); }
      .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; padding: 1.5rem; box-shadow: 0 2px 6px rgba(22, 28, 45, .04); }
      code, pre { font-family: ui-monospace, Menlo, monospace; background: var(--alt); border: 1px solid var(--line); border-radius: 6px; }
      code { padding: .1em .35em; font-size: .9em; }
      pre { padding: 1rem; overflow-x: auto; }
      pre code { border: 0; padding: 0; }
      input, select, button, textarea { font: inherit; color: inherit; }
      input, select { background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: .6rem .8rem; min-width: 0; }
      input:focus-visible, select:focus-visible, button:focus-visible, a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
      .btn { white-space: nowrap; background: var(--accent); color: #fff; border: 0; border-radius: 6px; padding: .7rem 1.2rem; font-weight: 600; cursor: pointer; box-shadow: var(--shadow); transition: transform .15s; }
      .btn:hover { transform: translateY(-1px); }
      .btn:disabled { opacity: .5; cursor: default; transform: none; }
      .btn.ghost { background: var(--accent-soft); color: var(--accent-ink); box-shadow: none; }
      .error { color: var(--bad); }
    </style>
  </head>
  <body>
    <header>
      <div class="wrap">
        <a href="/" aria-label="Flekto home"><img src="/logo.png" alt="Flekto" width="154" height="34" /></a>
        <nav>
          <a href="/">Home</a>
          <a href="/tools/" aria-current={Astro.url.pathname.startsWith("/tools") ? "page" : undefined}>Tools</a>
          <a href="mailto:info@flekto.nl">Contact</a>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer>
      <div class="wrap">
        <span>© {new Date().getFullYear()} Flekto.nl · Nav Appaiya</span>
        <span><a href="mailto:info@flekto.nl">info@flekto.nl</a> · <a href="tel:0103075430">(010) 307 5430</a></span>
      </div>
    </footer>
  </body>
</html>
